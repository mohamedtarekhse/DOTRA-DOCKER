# ============================================================
# ACUSEEK Environment Configuration
# COPY this file to .env and fill in your real values
# ============================================================

# --- Database ---
POSTGRES_USER=acuseek
POSTGRES_PASSWORD=acuseek_secret
POSTGRES_DB=acuseek

# --- Redis (broker/cache) ---
# The API and celery connect with: redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_PASSWORD=acuseek_redis_secret

# --- MinIO Object Storage ---
MINIO_ROOT_USER=acuseek
MINIO_ROOT_PASSWORD=acuseek_minio_secret

# --- MQTT broker (gate relay) ---
# Mosquitto requires auth — set a secret password here.
MQTT_USER=acuseek
MQTT_PASSWORD=acuseek_mqtt_secret

# --- Security ---
# JWT_SECRET MUST be at least 32 chars and NOT one of the well-known
# placeholder values — the API refuses to start without a strong secret.
JWT_SECRET=replace_this_with_a_random_32_plus_character_string_9k3
JWT_EXPIRE_MINUTES=1440
LPR_EVENT_SECRET=change_me_lpr_secret

# --- Dashboard/API admin login ---
# Change these! They are the default "admin/acuseek" credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=acuseek

# --- Telegram Notifications (Manager Alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Custom webhook secret token for the telegram-webhook endpoint.
# Leave empty to disable webhook-triggered approvals (fails closed).
TELEGRAM_WEBHOOK_SECRET=

# --- AI sampling (OPTIONAL; empty = disabled) ---
# JSON arrays of camera names the LPR listener / zone monitor should watch.
# Example: LPR_CAMERAS=["gate1","gate2"]  RESTRICTED_CAMERAS=["storage"]
LPR_CAMERAS=
RESTRICTED_CAMERAS=
INTRUSION_COOLDOWN=60

# --- Cloudflare Tunnel (OPTIONAL) ---
# Leave TUNNEL_TOKEN empty for a normal LAN install - the cloudflared
# service then stays disabled (it is behind the "remote" compose profile).
# Enable remote access: set the token below, then run:
#   docker compose --profile remote up -d cloudflared
# Get the token from Cloudflare Zero Trust -> Networks -> Tunnels -> Create.
TUNNEL_TOKEN=

# --- Server LAN address (for local dashboard access over Nginx) ---
SERVER_LAN_IP=192.168.10.50